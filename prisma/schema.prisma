generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://user@localhost:5432/viadb?schema=public"
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  description String
  imageUrl    String
  year        Int
  pages       Int
}